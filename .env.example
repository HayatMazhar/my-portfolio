# ── AI Models (all free tier) ────────────────────────────────────────────────

# Groq — AI chat widget, follow-up suggestions, RAG generation (GPT-OSS 120B)
# Free tier: https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini — embeddings for RAG demo (gemini-embedding-001)
# Free tier: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Cohere — reranking for RAG demo (rerank-v3.5, optional but improves accuracy)
# Free tier: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# Pinecone — vector store for RAG demo
# Free serverless tier: https://www.pinecone.io
PINECONE_API_KEY=

# ── Optional ─────────────────────────────────────────────────────────────────

# Buttondown — newsletter signups from /api/subscribe. When unset, submissions
# are validated and logged but not delivered anywhere (the form still succeeds).
# https://buttondown.com/settings/programming
# BUTTONDOWN_API_KEY=

# Public origin used for canonical URLs, OG images, and sitemap links.
# Defaults to https://mazharhayat.live — set this on any other deploy target
# (preview builds, forks) so social cards resolve against the right host.
# NEXT_PUBLIC_SITE_URL=

# GitHub personal access token — avoids rate limiting on activity feed
# GITHUB_TOKEN=

# /fit URL intake: postings that render client-side come back as an empty shell,
# so they fall back to a reader proxy that runs the page's JavaScript.
# Set to "off" to disable the fallback and only use the direct fetch.
# FIT_URL_RENDER=off
# FIT_URL_RENDER_ENDPOINT=https://r.jina.ai/
# Optional key for higher reader-proxy rate limits: https://jina.ai/reader
# JINA_API_KEY=

# ── Admin: LinkedIn post studio (/admin) ─────────────────────────────────────
# Prefer in-app settings (/admin/setup then /admin/settings) for API keys.
# Turso holds posts, comments, LinkedIn tokens, and those settings.
# Without these two vars the studio falls back to .data/admin-store.json.

TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ADMIN_PASSWORD=
# ADMIN_SESSION_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_ORGANIZATION_URN=urn:li:organization:123456
# ADMIN_CRON_SECRET=

# Instagram/LinkedIn artwork — Cloudflare Workers AI free allocation.
# Needs an Account API token (Manage account → Account API tokens), not a User
# API token, with Workers AI set to both Read and Edit. A user token verifies
# successfully but still returns 401 from /ai/run.
# IMAGE_PROVIDER=cloudflare
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
